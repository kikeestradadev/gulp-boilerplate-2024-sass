{
	"name": "gulp-boilerplate-2024",
	"version": "1.0.0",
	"assetVersion": "1.0.14",
	"description": "Simple scaffolding for static web projects with Gulp + Tailwind CSS 4",
	"type": "module",
	"main": "gulpfile.js",
	"homepage": "https://kikeestradadev.github.io/gulp-boilerplate-2024-tailwind-4/",
	"engines": {
		"node": ">=22.13.1"
	},
	"scripts": {
		"dev": "gulp",
		"build": "node scripts/bump-assets.mjs && NODE_ENV=production gulp build",
		"deploy": "npm run build && gh-pages -d public",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"gulp": "gulp"
	},
	"author": "Enrique Estrada",
	"license": "GPL-2.0",
	"dependencies": {
		"gh-pages": "^6.1.1",
		"prismjs": "^1.30.0"
	},
	"devDependencies": {
		"@prettier/plugin-pug": "^3.4.2",
		"@tailwindcss/postcss": "^4.1.11",
		"autoprefixer": "^10.4.20",
		"cssnano": "^7.0.6",
		"esbuild": "^0.28.0",
		"gulp": "^5.0.0",
		"gulp-data": "^1.3.1",
		"gulp-plumber": "^1.2.1",
		"gulp-pug": "^5.0.0",
		"html-minifier-next": "^7.5.2",
		"jstransformer-markdown-it": "^3.0.0",
		"postcss": "^8.5.25",
		"prettier": "^3.5.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"tailwindcss": "^4.0.14"
	},
	"overrides": {
		"markdown-it": "^15.0.0",
		"linkify-it": "^6.1.0"
	}
}
