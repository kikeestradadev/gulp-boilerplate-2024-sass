section#tabla.mx-auto.w-full.border(, class='max-w-[var(--main-container)] border-[steelblue] px-[15px]')
	.mx-auto.w-full.border(class='max-w-[var(--container)] border-[tomato]')
		h2.mb-6.font-bold(class='text-[length:var(--h2-size)] leading-[length:var(--h2-line)]') Tabla
		.w-full.overflow-x-auto
			table.w-max.max-w-none.border-collapse.text-left(
				class='min-w-[40rem] text-[length:var(--p-size)] leading-[length:var(--p-line)] text-[var(--paragraph-color)]'
			)
				thead
					tr.text-white(class='bg-[var(--first-color)]')
						th.border.px-4.py-3.font-semibold.whitespace-nowrap(class='border-[var(--first-color-alt)]') Nombre
						th.border.px-4.py-3.font-semibold.whitespace-nowrap(class='border-[var(--first-color-alt)]') Rol
						th.border.px-4.py-3.font-semibold.whitespace-nowrap(class='border-[var(--first-color-alt)]') Estado
						th.border.px-4.py-3.font-semibold.whitespace-nowrap(class='border-[var(--first-color-alt)]') Fecha
						th.border.px-4.py-3.font-semibold.whitespace-nowrap(class='border-[var(--first-color-alt)]') Accion
