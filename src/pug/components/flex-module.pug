- let coreSaludo = 'Core Module';
section#flex.mx-auto.w-full.border(, class='max-w-[var(--main-container)] border-[steelblue] px-[15px]') 
	.mx-auto.w-full.border(class='max-w-[var(--container)] border-[tomato]') 
		h1.font-bold(class='text-[length:var(--h1-size)] leading-[length:var(--h1-line)]') Flex
		.flex.flex-wrap
			- for (let i = 1; i <= 10; i++)
				.w-full.p-3(class='m:w-1/3 l:w-1/4 xxl:w-1/7 sm:w-1/2 lg:w-1/5 xl:w-1/6')
					.flex.h-32.items-center.justify-center.bg-red-300(class='min-[640px]:max-[1280px]:bg-[blue]')
						span: b= coreSaludo
							| #{ i }
