section(
	class='tutor-grid',
	id='tutor-grid',
	data-url=tutorGridData.dataUrl,
	data-persona-url=tutorGridData.personaDataUrl,
	data-storage-key=tutorGridData.storageKey,
	data-error-message=tutorGridData.errorMessage,
	data-empty-list=tutorGridData.emptyList,
	data-loading-message=tutorGridData.loadingMessage,
	data-created-message=tutorGridData.createdMessage,
	data-updated-message=tutorGridData.updatedMessage,
	data-deleted-message=tutorGridData.deletedMessage,
	data-delete-blocked-message=tutorGridData.deleteBlockedMessage,
	data-count-label=tutorGridData.countLabel,
	data-form-title-create=tutorGridData.formTitleCreate,
	data-form-title-edit=tutorGridData.formTitleEdit,
	data-submit-create=tutorGridData.submitLabelCreate,
	data-submit-update=tutorGridData.submitLabelUpdate,
	data-cancel-label=tutorGridData.cancelLabel,
	data-edit-label=tutorGridData.editLabel,
	data-delete-label=tutorGridData.deleteLabel,
	data-delete-confirm=tutorGridData.deleteConfirm
)
	h2(class='tutor-grid__title')= tutorGridData.title
	p(class='tutor-grid__lead')= tutorGridData.lead

	h3(class='tutor-grid__form-title')= tutorGridData.formTitleCreate
	form(class='tutor-grid__form', novalidate)
		input(class='tutor-grid__id', type='hidden', name='id', value='')
		each field in tutorGridData.fields
			div(class='tutor-grid__field')
				label(class='tutor-grid__label', for=`tutor-${field.name}`)= field.label
				input(
					class='tutor-grid__input',
					id=`tutor-${field.name}`,
					name=field.name,
					type=field.type,
					placeholder=field.placeholder,
					required=field.required
				)

		div(class='tutor-grid__actions')
			button(class='btn btn--primary tutor-grid__submit', type='submit')= tutorGridData.submitLabelCreate
			button(
				class='btn btn--secondary tutor-grid__cancel',
				type='button',
				hidden
			)= tutorGridData.cancelLabel

	p(class='tutor-grid__status', role='status')= tutorGridData.loadingMessage

	div(class='tutor-grid__toolbar')
		h3(class='tutor-grid__grid-title')= tutorGridData.gridTitle
		p(class='tutor-grid__count', hidden)

	div(class='tutor-grid__grid', aria-live='polite')

	div(class='tutor-grid__preview', hidden)
		h3(class='tutor-grid__preview-title')= tutorGridData.previewTitle
		pre(class='tutor-grid__preview-code')
			code(class='language-json')
