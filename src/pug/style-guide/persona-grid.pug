section(
	class='persona-grid',
	id='persona-grid',
	data-url=personaGridData.dataUrl,
	data-tutor-url=personaGridData.tutorDataUrl,
	data-storage-key=personaGridData.storageKey,
	data-error-message=personaGridData.errorMessage,
	data-empty-list=personaGridData.emptyList,
	data-loading-message=personaGridData.loadingMessage,
	data-created-message=personaGridData.createdMessage,
	data-updated-message=personaGridData.updatedMessage,
	data-deleted-message=personaGridData.deletedMessage,
	data-count-label=personaGridData.countLabel,
	data-form-title-create=personaGridData.formTitleCreate,
	data-form-title-edit=personaGridData.formTitleEdit,
	data-submit-create=personaGridData.submitLabelCreate,
	data-submit-update=personaGridData.submitLabelUpdate,
	data-cancel-label=personaGridData.cancelLabel,
	data-edit-label=personaGridData.editLabel,
	data-delete-label=personaGridData.deleteLabel,
	data-delete-confirm=personaGridData.deleteConfirm,
	data-tutor-empty-option=personaGridData.tutorEmptyOption,
	data-tutor-card-label=personaGridData.tutorCardLabel
)
	h2(class='persona-grid__title')= personaGridData.title
	p(class='persona-grid__lead')= personaGridData.lead

	h3(class='persona-grid__form-title')= personaGridData.formTitleCreate
	form(class='persona-grid__form', novalidate)
		input(class='persona-grid__id', type='hidden', name='id', value='')
		each field in personaGridData.fields
			div(class='persona-grid__field')
				label(class='persona-grid__label', for=`persona-${field.name}`)= field.label
				if field.type === 'select'
					select(
						class='persona-grid__select persona-grid__input',
						id=`persona-${field.name}`,
						name=field.name,
						required=field.required
					)
						option(value='')= personaGridData.tutorEmptyOption
				else
					input(
						class='persona-grid__input',
						id=`persona-${field.name}`,
						name=field.name,
						type=field.type,
						placeholder=field.placeholder,
						required=field.required,
						min=field.min,
						max=field.max,
						step=field.step
					)

		div(class='persona-grid__actions')
			button(class='btn btn--primary persona-grid__submit', type='submit')= personaGridData.submitLabelCreate
			button(
				class='btn btn--secondary persona-grid__cancel',
				type='button',
				hidden
			)= personaGridData.cancelLabel

	p(class='persona-grid__status', role='status')= personaGridData.loadingMessage

	div(class='persona-grid__toolbar')
		h3(class='persona-grid__grid-title')= personaGridData.gridTitle
		p(class='persona-grid__count', hidden)

	div(class='persona-grid__grid', aria-live='polite')

	div(class='persona-grid__preview', hidden)
		h3(class='persona-grid__preview-title')= personaGridData.previewTitle
		pre(class='persona-grid__preview-code')
			code(class='language-json')
